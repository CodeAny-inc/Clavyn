{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "os:default",
    "allow-startup-failure",
    "allow-set-aside-unreadable-file",
    "allow-restart-app",
    "allow-list-hosts",
    "allow-add-host",
    "allow-update-host",
    "allow-delete-host",
    "allow-list-groups",
    "allow-add-group",
    "allow-delete-group",
    "allow-list-identities",
    "allow-add-identity",
    "allow-update-identity",
    "allow-delete-identity",
    "allow-vault-is-initialized",
    "allow-secure-initialize-vault",
    "allow-secure-unlock-vault",
    "allow-secure-lock-vault",
    "allow-secure-reset-vault",
    "allow-is-vault-unlocked",
    "allow-biometric-available",
    "allow-biometric-passphrase-stored",
    "allow-store-biometric-passphrase",
    "allow-unlock-with-biometric",
    "allow-clear-biometric-passphrase",
    "allow-list-keys",
