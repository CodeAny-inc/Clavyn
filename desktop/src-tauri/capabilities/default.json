    "allow-close-session",
    "allow-list-sessions",
    "allow-sftp-connect",
    "allow-sftp-list-dir",
    "allow-sftp-canonicalize",
    "allow-sftp-create-dir",
    "allow-sftp-remove-file",
    "allow-sftp-remove-dir",
    "allow-sftp-rename",
    "allow-sftp-close",
    "allow-sftp-pick-upload-file",
    "allow-sftp-download-to-local",
    "allow-sftp-upload-from-local",
