{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clavyn",
  "version": "0.1.2-alpha.4",
  "identifier": "com.clavyn.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Clavyn",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; frame-src 'none'; child-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "appimage", "deb", "rpm", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Open-source SSH connection & key manager",
    "longDescription": "Clavyn is an open-source, cross-platform manager for SSH connections, keys, and known hosts. Secure-by-default: encrypted vault, OS keychain integration, TOFU host key verification.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "shell": {
      "open": "https://github\\.com/CodeAny-inc/Clavyn(/releases)?"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzOTFFMkUyNUVEMDI4QTgKUldTb0tOQmU0dUtSc3loK0p4Qm9xbmtWVzlBQXVaaVlNaG12Vk5mYnd4c2QyQ09LMGVtUWFoM2oK",
      "endpoints": [
        "https://github.com/CodeAny-inc/Clavyn/releases/latest/download/latest.json"
      ]
    }
  }
}
